.DEFAULT_GOAL := help

BUILD_DIR   ?= $(CURDIR)/build
CONFIG      ?= Debug
PREFIX      ?= $(HOME)/.local
APP_DEST    ?= /Applications
XCODEBUILD   = xcodebuild -project App/PNGuin.xcodeproj -scheme PNGuin -configuration $(CONFIG) -derivedDataPath $(BUILD_DIR)
APP          = $(BUILD_DIR)/Build/Products/$(CONFIG)/PNGuin.app
# xcodebuild writes the app's pins into the root Package.resolved, plain SwiftPM prunes them again; this keeps them.
SWIFTPM     := --force-resolved-versions

.PHONY: help generate build cli test run install install-cli list-devices clean

help: ## Show this help.
	@awk 'BEGIN { printf "PNGuin developer targets\n\nUsage:\n  make <target> [CONFIG=Release] [PREFIX=~/.local] [APP_DEST=/Applications]\n\nTargets:\n" } /^[a-zA-Z0-9_.-]+:.*##/ { split($$0, a, ":.*## "); printf "  %-14s %s\n", a[1], a[2] }' $(MAKEFILE_LIST)
	@printf "\nPrerequisites: Xcode 27+, xcodegen, shark (brew). Signing team goes into App/Config/Local.xcconfig.\n"

generate: ## Generate the Xcode project (XcodeGen).
	@test -f App/PNGuin/Resources/Shark.swift || echo '// regenerated by the Shark build phase' > App/PNGuin/Resources/Shark.swift
	cd App && xcodegen generate

build: generate ## Build the menu-bar app.
	$(XCODEBUILD) build | xcbeautify -qq

cli: ## Build the iphone-screenshot CLI (release).
	swift build $(SWIFTPM) -c release --product iphone-screenshot

test: ## Run the PNGuinKit unit tests.
	swift test $(SWIFTPM)

run: build ## Build and launch the app (logs to the terminal).
	LOGLEVEL=TRACE OS_ACTIVITY_MODE=disabled $(APP)/Contents/MacOS/PNGuin

install: CONFIG := Release
install: build ## Install the app to APP_DEST (default /Applications).
	rm -rf "$(APP_DEST)/PNGuin.app"
	cp -R "$(APP)" "$(APP_DEST)/"

install-cli: cli ## Install iphone-screenshot to PREFIX/bin.
	mkdir -p "$(PREFIX)/bin"
	install -m 755 .build/release/iphone-screenshot "$(PREFIX)/bin/iphone-screenshot"

list-devices: ## List paired iPhones/iPads with their availability.
	swift run $(SWIFTPM) -q iphone-screenshot list

clean: ## Remove build artifacts.
	rm -rf .build build App/PNGuin.xcodeproj
