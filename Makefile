.DEFAULT_GOAL := help
SHELL := /bin/bash -o pipefail

BUILD_DIR   ?= $(CURDIR)/build
CONFIG      ?= Debug
PREFIX      ?= $(HOME)/.local
APP_DEST    ?= /Applications
XCODEBUILD   = xcodebuild -project App/PNGuin.xcodeproj -scheme PNGuin -configuration $(CONFIG) -derivedDataPath $(BUILD_DIR)
APP          = $(BUILD_DIR)/Build/Products/$(CONFIG)/PNGuin.app
# xcodebuild writes the app's pins into the root Package.resolved, plain SwiftPM prunes them again; this keeps them.
SWIFTPM     := --force-resolved-versions
APP_VERSION := $(shell awk -F ' = ' '/^MARKETING_VERSION/ { print $$2; exit }' App/Config/Base.xcconfig)
RELEASE_DIR ?= $(CURDIR)/build/release-app
RELEASE_APP  = $(RELEASE_DIR)/Build/Products/Release/PNGuin.app
DIST_DIR    ?= $(CURDIR)/build/dist
APP_ARCHIVE  = $(DIST_DIR)/PNGuin-$(APP_VERSION)-macOS.zip
SIGN_IDENTITY ?= Developer ID Application: Michael Lauer (NANNL9SK66)
NOTARY_PROFILE ?= NOTARIZE

.PHONY: help generate build cli test run mac-run install install-cli list-devices clean app-package app-release app-upload

help: ## Show this help.
	@awk 'BEGIN { printf "PNGuin developer targets\n\nUsage:\n  make <target> [CONFIG=Release] [PREFIX=~/.local] [APP_DEST=/Applications]\n\nTargets:\n" } /^[a-zA-Z0-9_.-]+:.*##/ { split($$0, a, ":.*## "); printf "  %-14s %s\n", a[1], a[2] }' $(MAKEFILE_LIST)
	@printf "\nPrerequisites: Xcode 27+, xcodegen, shark 2.2.0+ (brew). Signing team goes into App/Config/Local.xcconfig.\n"
	@printf "Release: Developer ID signing identity, NOTARY_PROFILE (default NOTARIZE), authenticated gh for app-upload.\n"

generate: ## Generate the Xcode project (XcodeGen).
	@test -f App/PNGuin/Resources/Shark.swift || echo '// regenerated by the Shark build phase' > App/PNGuin/Resources/Shark.swift
	cd App && xcodegen generate

build: generate ## Build the menu-bar app.
	$(XCODEBUILD) build | xcbeautify -qq

cli: ## Build the iphone-screenshot CLI (release).
	swift build $(SWIFTPM) -c release --product iphone-screenshot

test: ## Run the PNGuinKit unit tests.
	swift test $(SWIFTPM)

run: build ## Build and launch the app (logs to the terminal).
	LOGLEVEL=TRACE OS_ACTIVITY_MODE=disabled $(APP)/Contents/MacOS/PNGuin

mac-run: run ## Build and launch the macOS app (alias for run).

install: CONFIG := Release
install: build ## Install the app to APP_DEST (default /Applications).
	rm -rf "$(APP_DEST)/PNGuin.app"
	cp -R "$(APP)" "$(APP_DEST)/"

install-cli: cli ## Install iphone-screenshot to PREFIX/bin.
	mkdir -p "$(PREFIX)/bin"
	install -m 755 .build/release/iphone-screenshot "$(PREFIX)/bin/iphone-screenshot"

list-devices: ## List paired iPhones/iPads with their availability.
	swift run $(SWIFTPM) -q iphone-screenshot list

app-package: generate ## Build and package the universal Developer ID app.
	xcodebuild -project App/PNGuin.xcodeproj -scheme PNGuin -configuration Release \
		-destination 'generic/platform=macOS' -derivedDataPath "$(RELEASE_DIR)" \
		-onlyUsePackageVersionsFromResolvedFile \
		ARCHS='arm64 x86_64' ONLY_ACTIVE_ARCH=NO CODE_SIGN_STYLE=Manual \
		CODE_SIGN_IDENTITY="$(SIGN_IDENTITY)" DEVELOPMENT_TEAM=NANNL9SK66 \
		ENABLE_HARDENED_RUNTIME=YES CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
		OTHER_CODE_SIGN_FLAGS='--timestamp' build | xcbeautify -qq
	codesign --verify --deep --strict --verbose=2 "$(RELEASE_APP)"
	lipo -verify_arch arm64 x86_64 "$(RELEASE_APP)/Contents/MacOS/PNGuin"
	@test "$$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$(RELEASE_APP)/Contents/Info.plist")" = "$(APP_VERSION)"
	@mkdir -p "$(DIST_DIR)"
	codesign -d --entitlements - "$(RELEASE_APP)" > "$(DIST_DIR)/entitlements.plist"
	@python3 -c 'import pathlib, plistlib, sys; data = pathlib.Path(sys.argv[1]).read_bytes(); p = plistlib.loads(data) if data else {}; sys.exit("Release app contains get-task-allow") if p.get("com.apple.security.get-task-allow") else None' "$(DIST_DIR)/entitlements.plist"
	ditto -c -k --keepParent --sequesterRsrc "$(RELEASE_APP)" "$(APP_ARCHIVE)"

app-release: ## Notarize the app and generate the Homebrew cask.
	@test -n "$(NOTARY_PROFILE)" || { echo 'Set NOTARY_PROFILE to a notarytool keychain profile.' >&2; exit 1; }
	$(MAKE) app-package
	xcrun notarytool submit "$(APP_ARCHIVE)" --keychain-profile "$(NOTARY_PROFILE)" --wait
	xcrun stapler staple "$(RELEASE_APP)"
	xcrun stapler validate "$(RELEASE_APP)"
	spctl -a -vv -t exec "$(RELEASE_APP)"
	ditto -c -k --keepParent --sequesterRsrc "$(RELEASE_APP)" "$(APP_ARCHIVE)"
	python3 scripts/write-cask.py --archive "$(APP_ARCHIVE)" --output "$(DIST_DIR)/pnguin.rb"

app-upload: ## Verify and upload the prepared app to the existing version's GitHub release.
	codesign --verify --deep --strict --verbose=2 "$(RELEASE_APP)"
	lipo -verify_arch arm64 x86_64 "$(RELEASE_APP)/Contents/MacOS/PNGuin"
	xcrun stapler validate "$(RELEASE_APP)"
	spctl -a -vv -t exec "$(RELEASE_APP)"
	ditto -c -k --keepParent --sequesterRsrc "$(RELEASE_APP)" "$(APP_ARCHIVE)"
	python3 scripts/write-cask.py --archive "$(APP_ARCHIVE)" --output "$(DIST_DIR)/pnguin.rb"
	gh release upload "v$(APP_VERSION)" "$(APP_ARCHIVE)" --repo mickeyl/PNGuin
	@printf '\nApp uploaded. Copy %s/pnguin.rb to homebrew-formulae/Casks/pnguin.rb and publish the tap.\n' "$(DIST_DIR)"

clean: ## Remove build artifacts.
	rm -rf .build build App/PNGuin.xcodeproj
